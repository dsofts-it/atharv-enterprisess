NODE_ENV=development
PORT=4000
CLIENT_URL=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/atharv?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# strict for local/same-site custom domains; none for separate onrender.com sites.
COOKIE_SAME_SITE=strict
# Frontend build only: API origin without /api/v1; empty uses the local Vite proxy.
VITE_API_ORIGIN=
VITE_SITE_ORIGIN=https://atharv-enterprises-8uv.pages.dev
# * preserves all-domain access. For real patient data, list exact trusted frontend origins.
CORS_ALLOWED_ORIGINS=*
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_WHATSAPP=
# Optional Resend email delivery; otherwise in-app delivery only.
EMAIL_API_KEY=
EMAIL_FROM=
# Explicit setup credentials, never a built-in password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
